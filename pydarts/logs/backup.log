+ tar -zcvf /pydarts/backup/raspydarts_V4.4.2_20240930_0859.tgz --exclude=__init__.py --exclude=__pycache__ --exclude=*.tgz --exclude=*.log --exclude backup --exclude logs /pydarts /home/pi/.pydarts
